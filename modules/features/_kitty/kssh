#!/usr/bin/env bash
# kssh - kitty's ssh kitten (proper terminfo bootstrap + shell integration),
# wrapped with k-shell-helper so kitty's re-entry keybinds (cmd+t / cmd+n /
# ctrl+shift+enter, see shell-reentry.md) reopen the SAME `kitty +kitten ssh`
# invocation, not a fresh local shell.
#
# Usage: kssh [ssh-options...] destination [remote-command...]
#
# Publishes a cmd: handle -- the full, shell-quoted `kitty +kitten ssh $@`
# argv -- instead of the built-in ssh: scheme, which dispatches re-entry to
# plain `ssh -t`. Plain ssh inherits this process's KITTY_* env vars
# (KITTY_INSTALLATION_DIR etc.); if the remote host also runs kitty locally
# and its own shell rc trusts those vars unconditionally (as ours does --
# see ~/.zshrc's KITTY_INSTALLATION_DIR block), it can end up trying to
# source integration from a client-side path that doesn't exist there.
# Harmless (a stray warning, shell still lands fine) but noisy. Re-entering
# via the actual kitten avoids it: the kitten sets up its own clean remote
# environment every time, identically to the primary connection.
#
# Bonus of capturing the whole argv instead of a bare destination: re-entry
# reproduces the exact invocation, remote-command and all -- no "last arg is
# the host" guesswork.
#
# The handle re-invokes `kssh "$@"` (this script), not the raw kitten
# command directly. That's what makes re-entry recursive: a pane opened
# from an already-ssh'd pane runs through k-shell-helper wrap again,
# republishing its own k_shell_reentry -- so a third-level pane-open still
# lands on the same host instead of falling back to a local shell. Handing
# the kitten command straight to `cmd:` would only wrap once, at the
# outermost hop.
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "usage: kssh [ssh-options...] destination [remote-command...]" >&2
  exit 2
fi

argv=(kssh "$@")
quoted=""
for arg in "${argv[@]}"; do
  quoted+="$(printf '%q' "$arg") "
done

exec k-shell-helper wrap "cmd:${quoted% }" -- kitty +kitten ssh "$@"
